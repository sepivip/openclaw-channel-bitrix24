{
  "id": "bitrix24",
  "name": "Bitrix24",
  "description": "Bitrix24 channel plugin (imbot.v2 fetch mode, outbound-only; no inbound HTTP surface).",
  "categories": [
    "channels"
  ],
  "channels": [
    "bitrix24"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "bitrix24": {
      "label": "Bitrix24",
      "description": "Bitrix24 imbot.v2 chat bot polled in fetch mode. No inbound HTTP surface.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Disabled by default. Nothing starts until this is explicitly true."
          },
          "name": {
            "type": "string",
            "description": "Display name for this account."
          },
          "webhookUrl": {
            "description": "SecretInput. Bitrix24 inbound webhook base URL https://<portal>/rest/<userId>/<token>/ . Use ${BITRIX24_WEBHOOK_URL}.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "provider",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "env",
                      "file",
                      "exec",
                      "store"
                    ]
                  },
                  "provider": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "botToken": {
            "description": "SecretInput. Caller-generated bot token (<=40 chars) required on every imbot.v2 call under webhook auth. Use ${BITRIX24_BOT_TOKEN}.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "provider",
                  "id"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "env",
                      "file",
                      "exec",
                      "store"
                    ]
                  },
                  "provider": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "portalDomain": {
            "type": "string",
            "description": "Portal domain the webhook host must end with, e.g. example.bitrix24.eu. Required for URL validation."
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "allowlist",
              "pairing",
              "disabled"
            ],
            "default": "allowlist",
            "description": "Default deny. There is deliberately no 'open' value for this channel."
          },
          "allowFrom": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "description": "Numeric Bitrix24 user ids. Non-numeric entries are dropped with a warning."
          },
          "groupPolicy": {
            "type": "string",
            "enum": [
              "disabled"
            ],
            "default": "disabled",
            "description": "Group chats are out of MVP scope."
          },
          "bot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "default": "openclaw_bot"
              },
              "name": {
                "type": "string",
                "default": "Assistant"
              },
              "color": {
                "type": "string",
                "default": "PURPLE"
              },
              "workPosition": {
                "type": "string",
                "default": "AI Assistant"
              }
            }
          },
          "poll": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "idleMs": {
                "type": "integer",
                "minimum": 1000,
                "default": 15000
              },
              "activeMs": {
                "type": "integer",
                "minimum": 500,
                "default": 3000
              }
            }
          },
          "allowInsecureHttpForTests": {
            "type": "boolean",
            "default": false,
            "description": "OFFLINE TESTS ONLY. Permits a plain http:// webhookUrl so a local fake-Bitrix stub can be driven without TLS. Honoured ONLY when NODE_ENV=test or BITRIX24_ALLOW_INSECURE_HTTP=1. Never set this in production."
          }
        }
      },
      "uiHints": {
        "webhookUrl": {
          "label": "Inbound webhook URL",
          "sensitive": true
        },
        "botToken": {
          "label": "Bot token",
          "sensitive": true
        },
        "portalDomain": {
          "label": "Portal domain",
          "placeholder": "example.bitrix24.eu"
        },
        "allowFrom": {
          "label": "Allowed Bitrix24 user ids"
        },
        "allowInsecureHttpForTests": {
          "label": "Allow insecure http (tests only)"
        }
      }
    }
  }
}
