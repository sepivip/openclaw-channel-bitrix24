// EXAMPLE ONLY — documented, NOT applied.
//
// The `channels.bitrix24` configuration block with every switch in its safe position.
// Nothing here is a secret: the two credentials are env SecretRefs resolved by
// OpenClaw core at runtime, so the real values live only in the gateway environment
// (for example a gitignored, access-controlled .env file) and never land in openclaw.json.

{
  plugins: {
    load: {
      // Read-only mount provided by docker-compose.bitrix24.yml
      paths: ["/opt/plugins/bitrix24"],
    },
    entries: {
      // Loads the plugin. Loading is NOT starting: the channel below is still
      // disabled, so no account starts and no Bitrix24 call is made.
      bitrix24: { enabled: true },
    },
  },

  channels: {
    bitrix24: {
      // DISABLED. Flip to true only when you're ready to enable the channel.
      // Nothing polls and nothing registers while false.
      enabled: false,

      // Env SecretRefs. Resolved by core; the values are never stored in openclaw.json.
      webhookUrl: { source: "env", provider: "default", id: "BITRIX24_WEBHOOK_URL" },
      botToken: { source: "env", provider: "default", id: "BITRIX24_BOT_TOKEN" },

      // Host gate for the REST client. The webhook host must END WITH this.
      portalDomain: "example.bitrix24.eu",

      // Default deny. There is no "open" value for this channel.
      dmPolicy: "allowlist",

      // Numeric Bitrix24 user ids only; non-numeric entries are dropped with a warning.
      // Empty means nobody is allowed — that is the intended default.
      allowFrom: [],

      // Group chats are OFF. "allowlist" (the only other value; there is no
      // "open") admits ONLY the chats listed in `groups`, only when the bot is
      // @mentioned, and only from senders in allowFrom. ONIMBOTV2JOINCHAT is
      // logged at info (dialog id, who added the bot, guard verdict, listed?).
      groupPolicy: "disabled",
      // groups: { "chat<N>": { requireMention: true } },

      bot: {
        code: "openclaw_bot",
        name: "Assistant",
        color: "PURPLE",
        workPosition: "AI Assistant",
      },

      poll: {
        idleMs: 15000,
        activeMs: 3000,
      },

      // OFFLINE TESTS ONLY. Leave absent (or false) forever in production.
      // Even set to true it is inert unless the process also has NODE_ENV=test
      // or BITRIX24_ALLOW_INSECURE_HTTP=1.
      // allowInsecureHttpForTests: false,
    },
  },
}

// ---------------------------------------------------------------------------
// HOW TO APPLY (documented, not run)
//
// Never hand-edit openclaw.json. Apply via the CLI so the config schema, the
// SecretInput contract and the backup path all stay intact:
//
//   docker compose -f docker-compose.yml -f docker-compose.bitrix24.yml \
//     run --rm openclaw-cli config set --batch-json '[
//       {"path": "plugins.load.paths", "value": ["/opt/plugins/bitrix24"]},
//       {"path": "plugins.entries.bitrix24.enabled", "value": true},
//       {"path": "channels.bitrix24.enabled", "value": false},
//       {"path": "channels.bitrix24.webhookUrl", "value": {"source": "env", "provider": "default", "id": "BITRIX24_WEBHOOK_URL"}},
//       {"path": "channels.bitrix24.botToken", "value": {"source": "env", "provider": "default", "id": "BITRIX24_BOT_TOKEN"}},
//       {"path": "channels.bitrix24.portalDomain", "value": "example.bitrix24.eu"},
//       {"path": "channels.bitrix24.dmPolicy", "value": "allowlist"},
//       {"path": "channels.bitrix24.allowFrom", "value": []},
//       {"path": "channels.bitrix24.groupPolicy", "value": "disabled"}
//     ]'
//
// Enabling the channel is a SEPARATE, later, explicitly approved step:
//
//   ... config set channels.bitrix24.enabled true
// ---------------------------------------------------------------------------
