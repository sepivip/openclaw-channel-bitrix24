{
  "name": "@sepivip/openclaw-channel-bitrix24",
  "version": "0.2.0",
  "description": "Bitrix24 chat bot channel for OpenClaw: imbot.v2 in fetch mode, no inbound HTTP surface",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sepivip/openclaw-channel-bitrix24.git"
  },
  "homepage": "https://github.com/sepivip/openclaw-channel-bitrix24#readme",
  "bugs": {
    "url": "https://github.com/sepivip/openclaw-channel-bitrix24/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "bitrix24",
    "chatbot",
    "imbot"
  ],
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    },
    "install": {
      "clawhubSpec": "@sepivip/openclaw-channel-bitrix24",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    },
    "channel": {
      "id": "bitrix24",
      "label": "Bitrix24",
      "selectionLabel": "Bitrix24 (imbot.v2, fetch mode)",
      "detailLabel": "Bitrix24 chat bot",
      "blurb": "Polls imbot.v2.Event.get over an inbound webhook URL. No inbound HTTP surface.",
      "markdownCapable": false,
      "configuredState": {
        "env": {
          "anyOf": [
            "BITRIX24_WEBHOOK_URL"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "openclaw": "^2026.9.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
